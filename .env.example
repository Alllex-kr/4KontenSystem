# Lokale Entwicklung: PostgreSQL aus compose.dev.yml (starten mit: npm run db:start)
# Auf dem Server setzt compose.yml diesen Wert selbst, dort bleibt er unverändert.
DATABASE_URL="postgresql://finanzklee:finanzklee@localhost:5432/finanzklee"

# --- Nur auf dem Server (Docker, compose.yml) ---
# Deine Domain ohne https://, z. B. finanzklee.de. Daraus entstehen auch APP_URL und das HTTPS-Zertifikat.
# DOMAIN=""
# Langes Zufallspasswort für die Datenbank, erzeugen mit: openssl rand -hex 32
# POSTGRES_PASSWORD=""

# Öffentliche Adresse der App (für Rücksprünge von der Bank). Lokal reicht http://localhost:3000
APP_URL="http://localhost:3000"

# --- Bankanbindung (optional) ---
# Ohne diese Werte läuft die Demo-Bank. Anleitung: docs/BANKANBINDUNG.md
# BANKING_PROVIDER="finapi"
# FINAPI_ENV="sandbox"          # sandbox | live (live nur mit finAPI-Lizenzvertrag)
# FINAPI_CLIENT_ID=""
# FINAPI_CLIENT_SECRET=""
# 32 Byte Schlüssel, z. B. erzeugen mit: openssl rand -base64 32
# BANKING_ENCRYPTION_KEY=""

# --- Adminbereich ---
# Diese E-Mail-Adressen haben immer Adminrechte (Komma-getrennt). Schutz davor, sich auszusperren.
# Alle weiteren Rechte vergibst du in der App unter /admin.
ADMIN_EMAILS=""

# --- KI-Kategorisierung (optional) ---
# API-Schlüssel aus der Anthropic-Konsole. Ohne Schlüssel bleibt die KI aus.
# ANTHROPIC_API_KEY=""

# --- Anmeldung mit Google (optional) ---
# Ohne diese Werte bleibt der Google-Button ausgeblendet. Anleitung: docs/GOOGLE-LOGIN.md
# Weiterleitungs-URI bei Google: <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- E-Mail-Versand (Pflicht für den Livegang) ---
# Für Bestätigungs-E-Mails und "Passwort vergessen". Jeder SMTP-Zugang geht, z. B. dein netcup-Postfach
# oder ein Versanddienst (Brevo, Mailjet, Amazon SES …). Lokal ohne diese Werte: E-Mails erscheinen im Terminal.
# SMTP_HOST=""
# SMTP_PORT="587"               # 587 = STARTTLS, 465 = SSL
# SMTP_USER=""
# SMTP_PASS=""
# Absender, z. B. "FinanzKlee <noreply@finanzklee.de>"
# MAIL_FROM=""
# Name und Adresse des Versand-Anbieters für die Datenschutzerklärung
# MAIL_PROVIDER=""

# --- Impressum und Datenschutz (Pflicht für den Livegang) ---
# Erscheinen auf /impressum und /datenschutz. Stehen hier statt im Code, damit deine Adresse nicht auf GitHub landet.
IMPRESSUM_NAME=""
IMPRESSUM_STREET=""
IMPRESSUM_CITY=""
IMPRESSUM_EMAIL=""
# IMPRESSUM_PHONE=""
# Name und Adresse deines Server-Anbieters, z. B. "Hetzner Online GmbH, Industriestr. 25, 91710 Gunzenhausen"
HOSTING_PROVIDER=""

# --- Sicherungen (scripts/backup.sh auf dem Server) ---
# BACKUP_DIR="backups"
# BACKUP_KEEP_DAYS="14"
