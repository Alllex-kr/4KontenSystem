DATABASE_URL="file:./dev.db"

# Öffentliche Adresse der App (für Rücksprünge von der Bank). Lokal reicht http://localhost:3000
APP_URL="http://localhost:3000"

# --- Bankanbindung (optional) ---
# Ohne diese Werte läuft die Demo-Bank. Anleitung: docs/BANKANBINDUNG.md
# BANKING_PROVIDER="finapi"
# FINAPI_ENV="sandbox"          # sandbox | live (live nur mit finAPI-Lizenzvertrag)
# FINAPI_CLIENT_ID=""
# FINAPI_CLIENT_SECRET=""
# 32 Byte Schlüssel, z. B. erzeugen mit: openssl rand -base64 32
# BANKING_ENCRYPTION_KEY=""

# --- Adminbereich ---
# Diese E-Mail-Adressen haben immer Adminrechte (Komma-getrennt). Schutz davor, sich auszusperren.
# Alle weiteren Rechte vergibst du in der App unter /admin.
ADMIN_EMAILS=""

# --- KI-Kategorisierung (optional) ---
# API-Schlüssel aus der Anthropic-Konsole. Ohne Schlüssel bleibt die KI aus.
# ANTHROPIC_API_KEY=""

# --- Anmeldung mit Google (optional) ---
# Ohne diese Werte bleibt der Google-Button ausgeblendet. Anleitung: docs/GOOGLE-LOGIN.md
# Weiterleitungs-URI bei Google: <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
